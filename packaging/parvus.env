# Parvus refuses to start until every value below is set.
# The meaning of each setting: https://parvus.recregt.com/reference/configuration/

# Your site's domain, for example notes.example.com
PARVUS_RP_ID=

# Your site's name, shown by devices when they create a passkey
PARVUS_RP_NAME=

# Every origin your users' browsers show, separated by commas,
# for example https://notes.example.com
PARVUS_ORIGINS=

# The most passkeys one account may hold, for example 20
PARVUS_MAX_CREDENTIALS=

PARVUS_DB=/var/lib/parvus/parvus.db
PARVUS_LISTEN=unix:/run/parvus/parvus.sock
